{
  "name": "orca-zh-tw-installer",
  "version": "3.0.2",
  "description": "Orca AI IDE 台灣繁體中文 (zh-TW) 一鍵安裝包",
  "main": "index.js",
  "bin": {
    "orca-zh-tw": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "build": "node scripts/build-nested.js",
    "lint:terms": "node scripts/sweep-terms.js",
    "lint:spacing": "node scripts/sweep-spacing.js",
    "verify": "node scripts/verify-install.js",
    "dry-run": "node index.js --dry-run",
    "ref:es": "node scripts/extract-reference-locale.js es",
    "audit:ref": "node scripts/extract-reference-locale.js es > .ref-es.json && node scripts/audit-vs-reference.js .ref-es.json",
    "audit:identifiers": "node scripts/extract-reference-locale.js es > .ref-es.json && node scripts/extract-reference-locale.js ja > .ref-ja.json && node scripts/extract-reference-locale.js ko > .ref-ko.json && node scripts/audit-identifiers.js .",
    "ref:all": "node scripts/extract-reference-locale.js es > .ref-es.json && node scripts/extract-reference-locale.js ja > .ref-ja.json && node scripts/extract-reference-locale.js ko > .ref-ko.json",
    "audit:plural": "npm run ref:all && node scripts/audit-plural-placeholder.js --dir .",
    "show": "node scripts/show-multilang.js",
    "audit:consistency": "npm run ref:all && node scripts/audit-consistency.js",
    "audit:classify": "npm run ref:all && node scripts/audit-consistency-classify.js",
    "unify:phrasing": "node scripts/unify-phrasing.js",
    "build:plugin": "node scripts/audit-lookup-keys.js && node scripts/build-plugin.js",
    "release:plugin": "node scripts/release-plugin.js",
    "audit:lookup": "node scripts/audit-lookup-keys.js"
  },
  "keywords": [
    "orca",
    "zh-tw",
    "translation",
    "traditional-chinese",
    "patch"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moksa1123/orca-zh-tw-installer.git"
  },
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
